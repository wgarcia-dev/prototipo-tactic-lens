# PostgreSQL existente en Windows
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Usuario operativo dedicado. El arranque verifica privilegios en producción
# y también en desarrollo cuando se habilita esta opción.
DATABASE_ENFORCE_RUNTIME_ROLE=true
# Solo para migraciones y mantenimiento. Inyectar en la sesión administrativa.
DATABASE_MIGRATION_USER=
DATABASE_MIGRATION_PASSWORD=
# Opcional si los clientes PostgreSQL 18 no estan en PATH ni en Program Files:
# PG_BIN_DIRECTORY=C:/Program Files/PostgreSQL/18/bin
HONEYPOT_ID=
# Optional: distinct registered UUIDs. HONEYPOT_ID remains the legacy source.
HONEYPOT_ID_COWRIE_SHELL=
HONEYPOT_ID_COWRIE_PROXY=
HONEYPOT_ID_COWRIE_LLM=
# Compatibilidad documental; Uvicorn se inicia con --host 127.0.0.1.
DEV_HOST_IP=127.0.0.1

# Clave compartida solo con el recolector Cowrie
INGEST_API_KEY=

# Análisis real desde FastAPI
LLM_MODE=real
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
LLM_ANALYSIS_TIMEOUT_SECONDS=300

# Correlación de descargas. Vacío usa el orden de los eventos de la misma sesión.
# Si se configura, use segundos enteros positivos según la latencia del laboratorio.
IOC_CORRELACION_MAX_SEGUNDOS=

# Autenticación. Genere claves locales con: python -m scripts.configure_auth
# Nunca copie estas claves al frontend, al recolector ni a Git.
AUTH_SECRET_KEY=
# Una o varias claves Fernet separadas por comas; la primera cifra, todas descifran.
AUTH_TOTP_KEYS=
AUTH_ENV=development
# Demo HTTP local: iniciar con scripts/windows/Iniciar-DemoHTTP.ps1.
# El script establece INGEST_TRANSPORT=demo-http, INGEST_DEMO_LOCAL_IP y
# INGEST_DEMO_UBUNTU_IP solo para el proceso, con clave privada en .local/demo-http/.
# No active esa modalidad en producción ni copie la clave al frontend.
AUTH_COOKIE_SECURE=false
AUTH_PUBLIC_URL=http://127.0.0.1:5173
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_EMAIL_TTL_SECONDS=300
AUTH_RESEND_SECONDS=60
AUTH_MAX_ATTEMPTS=5
AUTH_CHALLENGE_SECONDS=300
AUTH_SESSION_SECONDS=28800
AUTH_IDLE_SECONDS=1800
AUTH_RESET_SECONDS=900
AUTH_REGISTRATION_PROOF_SECONDS=900
AUTH_TEMP_PASSWORD_SECONDS=86400
AUTH_RECOVERY_REQUEST_SECONDS=86400
AUTH_RECENT_ACTIVITY_SECONDS=120

# Desarrollo local: mensajes .eml en una carpeta ignorada por Git, sin enviar fuera.
# Producción: MAIL_TRANSPORT=smtp, HTTPS y AUTH_COOKIE_SECURE=true son obligatorios.
MAIL_TRANSPORT=file
MAIL_DEV_DIRECTORY=.local/mail
MAIL_FROM="TacticLens <no-reply@tacticlens.app>"
# Buzones humanos en Zoho: solo recepción/respuesta manual, sin IMAP/POP/SMTP Zoho.
ADMIN_EMAIL=admin@tacticlens.app
SUPPORT_EMAIL=soporte@tacticlens.app
MAIL_TIMEZONE=America/Guayaquil
MAIL_ALERT_THRESHOLD=5
MAIL_ALERT_WINDOW_SECONDS=900
MAIL_ALERT_COOLDOWN_SECONDS=900
MAIL_NOTIFICATION_MAX_ATTEMPTS=3
MAIL_OUTBOX_ENABLED=true
MAIL_OUTBOX_POLL_SECONDS=5
COWRIE_IMPORT_MAX_BYTES=10000000
COWRIE_IMPORT_MAX_RECORDS=20000
COWRIE_IMPORT_BATCH_SIZE=100
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=true
# Resend: cambie MAIL_TRANSPORT a smtp en el .env para enviar correos reales.
# SMTP_PASSWORD recibe la API Key de Resend; introdúzcala solo en el .env privado.

# RAG MITRE: modelo ONNX local en CPU; ruta opcional, sin credenciales.
# Por defecto usa .local/rag/models/minilm dentro del proyecto.
# Preparar con: python -m scripts.embed_mitre --preparar-modelo
# RAG_MODEL_DIRECTORY=C:/ruta/privada/modelos/minilm
# Enriquecimiento: todo es opcional. Sin claves, funciona sin Internet.
# Descargue una copia versionada de MISP/misp-warninglists y apunte a la carpeta lists.
# MISP_WARNING_LISTS_DIR=C:/ruta/privada/misp-warninglists/lists
# Las claves abuse.ch activan consultas de IP pública/dominio/hash a ThreatFox
# y hash SHA-256 a URLhaus. No se envían credenciales ni comandos capturados.
THREATFOX_AUTH_KEY=
THREATFOX_TIMEOUT_SECONDS=2
THREATFOX_REQUESTS_PER_MINUTE=30
URLHAUS_TIMEOUT_SECONDS=2
URLHAUS_REQUESTS_PER_MINUTE=30
ENRICHMENT_TOTAL_TIMEOUT_SECONDS=4
ENRICHMENT_RETRIES=1
ENRICHMENT_CACHE_TTL_SECONDS=3600
ENRICHMENT_CACHE_MAX_ENTRIES=512
URLHAUS_AUTH_KEY=
# Puerto 465: SSL directo, sin STARTTLS. El dominio remitente debe estar verificado.
# Guía y reinicio local: docs/CORREO_SMTP.md. No copiar credenciales aquí.
