# PostgreSQL existente en Windows
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
HONEYPOT_ID=
DEV_HOST_IP=192.168.56.1

# Clave compartida solo con el recolector Cowrie
INGEST_API_KEY=

# Análisis real desde FastAPI
LLM_MODE=real
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60

# Autenticación. Genere claves locales con: python -m scripts.configure_auth
# Nunca copie estas claves al frontend, al recolector ni a Git.
AUTH_SECRET_KEY=
# Una o varias claves Fernet separadas por comas; la primera cifra, todas descifran.
AUTH_TOTP_KEYS=
AUTH_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_PUBLIC_URL=http://127.0.0.1:5173
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_EMAIL_TTL_SECONDS=300
AUTH_RESEND_SECONDS=60
AUTH_MAX_ATTEMPTS=5
AUTH_CHALLENGE_SECONDS=300
AUTH_SESSION_SECONDS=28800
AUTH_IDLE_SECONDS=1800
AUTH_RESET_SECONDS=900
AUTH_REGISTRATION_PROOF_SECONDS=900
AUTH_TEMP_PASSWORD_SECONDS=86400

# Desarrollo local: mensajes .eml en una carpeta ignorada por Git, sin enviar fuera.
# Producción: MAIL_TRANSPORT=smtp, HTTPS y AUTH_COOKIE_SECURE=true son obligatorios.
MAIL_TRANSPORT=file
MAIL_DEV_DIRECTORY=.local/mail
MAIL_FROM=TacticLens <no-reply@tacticlens.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# Gmail temporal: MAIL_TRANSPORT=smtp, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
# SMTP_USER y la dirección de MAIL_FROM deben usar tu Gmail completo.
# SMTP_PASSWORD recibe la contraseña de aplicación; introdúcela solo en .env.
# Mantener STARTTLS=true y SSL=false para el puerto 587.
# Guía y reinicio local: docs/CORREO_SMTP.md. No copiar credenciales aquí.
