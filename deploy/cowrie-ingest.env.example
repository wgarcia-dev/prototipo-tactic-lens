# Archivo de ejemplo para /home/cowrie/.config/cowrie-ingest.env en Ubuntu
# Ajuste la IP del anfitrion y use la misma clave que INGEST_API_KEY en Windows.
INGEST_URL=http://192.168.56.1:8000/api/ingesta/eventos
INGEST_API_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA
COWRIE_LOG=/home/cowrie/my-honeypot/var/log/cowrie/cowrie.json
COLLECTOR_STATE=/home/cowrie/.config/cowrie-ingest-state.json