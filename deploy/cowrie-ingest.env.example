# Instalar como /etc/tacticlens-cowrie/exportador.env (root:cowrie, 0640).
# El transporte por defecto usa un túnel local ya habilitado.
TACTICLENS_URL=http://127.0.0.1:18765/api/ingesta/eventos
TACTICLENS_TOKEN=REEMPLAZAR_CON_CLAVE_DE_INGESTA
TACTICLENS_TRANSPORT=ssh-loopback
COWRIE_LOG=/home/cowrie/my-honeypot/var/log/cowrie/cowrie.json
TACTICLENS_BATCH_SIZE=50
TACTICLENS_MAX_PENDING=50000
# Para demo-http use la IP privada del backend y la configuración de docs/DEMO_LAPTOPS.md.
